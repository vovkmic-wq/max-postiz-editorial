    "/mobile/v1/operations/{operation_id}": {
      "get": {
        "summary": "Operation Status",
        "operationId": "operation_status_mobile_v1_operations__operation_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Operation Id"
            }
          },
          {
            "name": "plan_id",
            "in": "query",
            "required": false,
            "description": "Use with plan_hash after a missing operation receipt to check the expired original plan.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "plan_hash",
            "in": "query",
            "required": false,
            "description": "Exact hash returned when the original plan was created.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Mobile session required",
            "content": {
              "application/json": {
                "schema": {
