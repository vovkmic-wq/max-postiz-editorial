  "components": {
    "schemas": {
      "AuditPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OperationReceipt"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "AuditPage"
      },
      "Capabilities": {
        "properties": {
          "environment_id": {
            "type": "string",
            "title": "Environment Id"
          },
          "server_version": {
            "type": "string",
            "title": "Server Version"
          },
          "api_version": {
            "type": "integer",
            "const": 1,
            "title": "Api Version"
          },
          "server_time": {
            "type": "string",
            "title": "Server Time"
          },
          "project_timezone": {
            "type": "string",
            "title": "Project Timezone"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "operator",
              "editor",
              "viewer"
            ],
            "title": "Role"
          },
          "actions": {
            "items": {
              "type": "string",
              "enum": [
                "pause_project",
                "resume_project",
                "pause_target",
                "resume_target",
                "hold_item",
                "release_item_hold",
                "reconcile_dispatch",
                "retire_preapproval_no_send"
              ]
            },
            "type": "array",
            "title": "Actions"
          }
        },
        "type": "object",
        "required": [
          "environment_id",
          "server_version",
          "api_version",
          "server_time",
          "project_timezone",
          "role",
          "actions"
        ],
        "title": "Capabilities"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "correlation_id": {
            "type": "string",
            "title": "Correlation Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "correlation_id"
        ],
        "title": "ErrorBody"
      },
      "OperationInput": {
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Operation Id"
          },
          "plan_id": {
            "type": "string",
            "format": "uuid",
            "title": "Plan Id"
          },
          "plan_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Plan Hash"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed"
          },
          "reason": {
            "type": "string",
            "maxLength": 512,
            "minLength": 3,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation_id",
          "plan_id",
          "plan_hash",
          "confirmed",
          "reason"
        ],
        "title": "OperationInput"
      },
      "OperationReceipt": {
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Operation Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "pause_project",
              "resume_project",
              "pause_target",
              "resume_target",
              "hold_item",
              "release_item_hold",
              "reconcile_dispatch",
              "retire_preapproval_no_send"
            ],
            "title": "Action"
          },
          "object_id": {
            "type": "string",
            "title": "Object Id"
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "succeeded",
              "blocked",
              "unknown"
            ],
            "title": "State"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "actor": {
            "type": "string",
            "title": "Actor"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "operation_id",
          "action",
          "object_id",
          "state",
          "code",
          "result",
          "actor",
          "reason",
          "created_at",
          "updated_at"
        ],
        "title": "OperationReceipt"
      },
      "PlanInput": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "pause_project",
              "resume_project",
              "pause_target",
              "resume_target",
              "hold_item",
              "release_item_hold",
              "reconcile_dispatch",
              "retire_preapproval_no_send"
            ],
            "title": "Action"
          },
          "object_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "title": "Object Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "object_id"
        ],
        "title": "PlanInput"
      },
      "PlanReceipt": {
        "properties": {
          "plan_id": {
            "type": "string",
            "format": "uuid",
            "title": "Plan Id"
          },
          "plan_hash": {
            "type": "string",
            "title": "Plan Hash"
          },
          "action": {
            "type": "string",
            "enum": [
              "pause_project",
              "resume_project",
              "pause_target",
              "resume_target",
              "hold_item",
              "release_item_hold",
              "reconcile_dispatch",
              "retire_preapproval_no_send"
            ],
            "title": "Action"
          },
          "object_id": {
            "type": "string",
            "title": "Object Id"
          },
          "effect": {
            "type": "string",
            "title": "Effect"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "plan_id",
          "plan_hash",
          "action",
          "object_id",
          "effect",
          "expires_at",
          "details"
        ],
        "title": "PlanReceipt"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
