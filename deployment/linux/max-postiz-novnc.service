[Unit]
Description=Loopback noVNC accessed over owner SSH tunnel
After=max-postiz-vnc.service
Requires=max-postiz-vnc.service

[Service]
User=editorial
ExecStart=/usr/bin/websockify --web=/usr/share/novnc 127.0.0.1:6080 127.0.0.1:5900
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
