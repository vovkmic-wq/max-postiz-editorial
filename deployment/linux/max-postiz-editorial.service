[Unit]
Description=Автономная редакция Postiz
After=network-online.target docker.service max-postiz-opencode.service
Wants=network-online.target max-postiz-opencode.service
Conflicts=max-postiz-hub.service

[Service]
Type=simple
User=editorial
WorkingDirectory=/opt/max-postiz
ExecStart=/opt/max-postiz/.venv/bin/python -m max_postiz_agent.server_cli serve --host 0.0.0.0 --port 8092
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
