+// Формула T5Attention._relative_position_bucket из эталонного Transformers.
+// Режим явно зависит от типа слоя, а не от включённого KV cache.
+fn relative_position_bucket(query: u32, key: u32, num_buckets: u32,
+                            max_distance: u32, bidirectional: bool) -> u32 {
+    let mut direction = 0;
+    let mut buckets = num_buckets;
+    let distance = if bidirectional {
+        buckets /= 2;
+        if key > query { direction = buckets; }
+        query.abs_diff(key)
+    } else {
+        query.saturating_sub(key)
+    };
+    let max_exact = buckets / 2;
+    let bucket = if distance < max_exact {
+        distance
+    } else {
+        let logarithmic = ((distance as f32 / max_exact as f32).ln()
+            / (max_distance as f32 / max_exact as f32).ln()
+            * (buckets - max_exact) as f32) as u32;
+        (max_exact + logarithmic).min(buckets - 1)
+    };
+    direction + bucket
+}
