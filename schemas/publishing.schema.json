{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "postiz",
    "targets",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "postiz": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maintenance_offline_fixture": {"type": "boolean", "default": false},
        "base_url_env": {
          "type": "string"
        },
        "api_key_env": {
          "type": "string"
        },
        "public_origin_env": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "mutation_read_timeout_seconds": {
          "type": "integer",
          "minimum": 65,
          "maximum": 180,
          "default": 75
        },
        "max_video_verified": {
          "type": "boolean"
        },
        "approval_guard_verified": {
          "type": "boolean"
        },
        "browser_bridge_enabled": {
          "type": "boolean"
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "profile_id",
          "platform",
          "route",
          "destination",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "profile_id": {
            "type": "string"
          },
          "platform": {
            "enum": [
              "telegram",
              "max",
              "vk",
              "pikabu"
            ]
          },
          "route": {
            "enum": [
              "postiz",
              "max_browser",
              "max_api",
              "telegram_api",
              "vk_api",
              "vk_browser",
              "pikabu_browser",
              "manual",
              "disabled"
            ]
          },
          "destination": {
            "type": "string",
            "maxLength": 200
          },
          "enabled": {
            "type": "boolean"
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "adapter_mode": {"enum": ["fake", "live"]},
              "token_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
              "proxy_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
              "request_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
              "api_version": {"type": "string", "pattern": "^5\\.[0-9]{1,3}$"},
              "media_layout": {"enum": ["atomic", "photo_then_text", "auto"]},
              "owner": {"type": "string", "minLength": 1, "maxLength": 100},
              "profile_dir": {"type": "string", "pattern": "^data/[A-Za-z0-9_/-]+$"},
              "channel": {"enum": ["chrome", "chromium"]},
              "headless": {"type": "boolean"},
              "operation_timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 600},
              "dom_contract_verified": {"type": "boolean"},
              "dom_contract_profile": {"enum": ["personal-text-v1", "personal-image-v1"]},
              "media_contract_verified": {"type": "boolean"},
              "media_proof_policy": {"enum": ["exact-bytes-v1", "exact-pixels-v1", "native-asset-lineage-v1", "native-uniform-edge-lineage-v1"]},
              "media_contract_evidence": {"type": "string", "pattern": "^data/vk-media-[A-Za-z0-9_-]+\\.json$"},
              "media_contract_evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "dom_contract": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 1000}},
              "postiz_integration_id": {
                "type": "string",
                "maxLength": 128
              },
              "max_chars": {
                "type": "integer",
                "minimum": 1,
                "maximum": 40000
              },
              "settings": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "profile_id",
          "interval_seconds",
          "lookback_hours",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "profile_id": {
            "type": "string"
          },
          "interval_seconds": {
            "type": "integer",
            "minimum": 60
          },
          "lookback_hours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8760
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
