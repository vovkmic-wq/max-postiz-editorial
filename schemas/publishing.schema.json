{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "postiz",
    "targets",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "postiz": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_url_env": {
          "type": "string"
        },
        "api_key_env": {
          "type": "string"
        },
        "public_origin_env": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "max_video_verified": {
          "type": "boolean"
        },
        "approval_guard_verified": {
          "type": "boolean"
        },
        "browser_bridge_enabled": {
          "type": "boolean"
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "profile_id",
          "platform",
          "route",
          "destination",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "profile_id": {
            "type": "string"
          },
          "platform": {
            "enum": [
              "telegram",
              "max",
              "vk",
              "pikabu"
            ]
          },
          "route": {
            "enum": [
              "postiz",
              "max_browser",
              "max_api",
              "manual",
              "disabled"
            ]
          },
          "destination": {
            "type": "string",
            "maxLength": 200
          },
          "enabled": {
            "type": "boolean"
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "postiz_integration_id": {
                "type": "string",
                "maxLength": 128
              },
              "max_chars": {
                "type": "integer",
                "minimum": 1,
                "maximum": 40000
              },
              "settings": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "profile_id",
          "interval_seconds",
          "lookback_hours",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "profile_id": {
            "type": "string"
          },
          "interval_seconds": {
            "type": "integer",
            "minimum": 60
          },
          "lookback_hours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8760
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
