{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "channels"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "channels": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "queries",
          "local_prompts",
          "caption_title"
        ],
        "properties": {
          "queries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "local_prompts": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "description": "Положительное и отрицательное описание для локальной CLIP; предпочтительно английский язык."
          },
          "caption_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "image_type": {
            "enum": [
              "all",
              "photo",
              "illustration",
              "vector"
            ]
          },
          "interval_hours": {
            "enum": [
              1,
              2,
              3,
              4,
              6,
              8,
              12,
              24
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "top_n": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "min_views": {
                "type": "integer",
                "minimum": 0
              },
              "min_likes": {
                "type": "integer",
                "minimum": 0
              },
              "min_local_relevance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "min_width": {
                "type": "integer",
                "minimum": 1
              },
              "min_height": {
                "type": "integer",
                "minimum": 1
              },
              "max_downloads_per_scan": {
                "type": "integer",
                "minimum": 10,
                "maximum": 20
              }
            }
          },
          "schedule": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "interval_hours"
                ],
                "properties": {
                  "kind": {
                    "const": "interval"
                  },
                  "interval_hours": {
                    "enum": [
                      1,
                      2,
                      3,
                      4,
                      6,
                      8,
                      12,
                      24
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "weekdays",
                  "times"
                ],
                "properties": {
                  "kind": {
                    "const": "weekly"
                  },
                  "weekdays": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 7,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 6
                    }
                  },
                  "times": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 48,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
